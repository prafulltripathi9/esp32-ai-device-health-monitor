```gitignore
# ==========================================
# Operating System Files
# ==========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# Temporary and Backup Files
# ==========================================

*~
*.swp
*.swo
*.bak
*.tmp

# ==========================================
# Logs
# ==========================================

*.log

# ==========================================
# Build Artifacts
# ==========================================

build/
**/build/
dist/
*.o
*.a
*.out
*.exe
*.bin
*.elf
*.map

# ==========================================
# ESP-IDF
# ==========================================

sdkconfig
sdkconfig.old

flasher_args.json

managed_components/
components/.idf/
**/components/.idf/
**/components/components/

.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Local compiler configuration
.clangd/
.ccls-cache/
compile_commands.json

# ==========================================
# Local Hardware Credentials
# ==========================================

wifi_credentials.h

# ==========================================
# Environment Variables and Secrets
# ==========================================

.env
.env.*

# Allow safe example environment files
!.env.example
!**/.env.example

# ==========================================
# Python
# ==========================================

*.py[cod]
__pycache__/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# ==========================================
# Flutter / Dart
# ==========================================

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.flutter-logs/

# ==========================================
# Android Local Configuration
# ==========================================

local.properties
key.properties

# ==========================================
# IDE and Workspace Files
# ==========================================

.vscode/
.idea/
*.code-workspace
*.iml
*.user
*.workspace
*.suo
*.sln.docstates

# ==========================================
# Project Review Archives
# ==========================================

esp32-project-review.zip
```